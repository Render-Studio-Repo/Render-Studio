.env
.env.*
!.env.example
bambu-printers.json

# Runtime / user data
data/
projects/
backups/
inbox/
backend/local_private/
backend/render3d.db
logs/

# Local snapshots / backup trees (not for GitHub)
milestones/
**/cad.backup-*/
**/*.backup-*/
*.bak

# Temp vendor / experiment checkouts
tmp_*/
tmp-*/
tmp_img2threejs
tmp_jake_text_to_cad

# 3D / CAD model binaries (generate locally; do not upload)
*.glb
*.gltf
*.stl
*.step
*.stp
*.obj
*.3mf
*.ply
*.fbx
*.iges
*.igs
*.brep
*.brp
*.off
*.dae
*.usd
*.usda
*.usdc
*.abc
*.f3z

# Python
.venv/
.venv-mac/
myenv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# OS / editor / tooling
.cache/
.codex/
.cursor/
.cursor-server/
.local/
*.log

# Generated viewer bundles
backend/skills/cad-viewer/scripts/viewer/dist/


# Local CLI/tooling config (gh tokens, uv, etc.) — never upload
.config/
# Secrets / keys
*.pem
*.key
id_rsa*
scripts/credentials_google*.json

# Home dotfiles
.bash_history
.bash_logout
.bashrc
.profile
.python_history
.zshrc
.ssh/

# Local tool installs (do not commit)
/.bun/
/.agents/

# Upstream checkouts (icons copied into frontend/)
vendor/

# Third-party OS / SDK checkouts
integrations/*
# First-party SQL (not a vendor checkout)
!integrations/supabase/
!integrations/supabase/**

# Mac FreeCAD product local builds
mac-render-studio/dist/
mac-render-studio/logs/

# Ops runtime ticks (keep READMEs / .gitkeep)
ai-context/ops/**/logs/*
!ai-context/ops/**/logs/.gitkeep
ai-context/ops/**/*.log

# Never snapshot these into git
.DS_Store
mac-render-studio/runtime/

# Local session notes (keep on disk; do not commit)
Sam's Notes
**/Sam's Notes
*Sam's Notes*

# Conservative sync excludes (secrets + package installs)
node_modules/
credentials.json

# Private marketing ops, music library, taste knowledge — never GitHub
Marketing/
/Marketing/**

# Shared robotics download/mesh cache; avatar assets are shipped UI resources.
.robotics-packages/
!frontend/assets/avatars/kenney/*.glb
