{
  "note": "Keys work in Studio when focus is not in a text field, unless noted. Cmd is Ctrl on Windows/Linux. Canvas and Sketch own their letter keys while those tabs are active.",
  "href": "https://render3d.app/",
  "contexts": [
    {
      "id": "viewport",
      "title": "Viewport / SOLID",
      "when": "SOLID (or other 3D) tab; not typing; Canvas/Sketch/Wiring do not own the key.",
      "keys": [
        {"combo": "T", "action": "Transparent / ghost view (click parts, or entire model)", "keywords": ["transparent", "ghost", "opacity", "see-through"]},
        {"combo": "M", "action": "Measure — click two points, edges, or faces", "keywords": ["measure", "dimension", "distance"]},
        {"combo": "G", "action": "Transform gizmo — move", "keywords": ["gizmo", "move", "translate", "grab"]},
        {"combo": "R", "action": "Transform gizmo — rotate", "keywords": ["rotate", "rotation"]},
        {"combo": "S", "action": "Transform gizmo — scale", "keywords": ["scale", "resize"]},
        {"combo": "V", "action": "Select object / body", "keywords": ["select", "pick", "object"]},
        {"combo": "C", "action": "Pick corner", "keywords": ["corner", "vertex", "pick"]},
        {"combo": "F", "action": "Pick face (not Fit — Fit is the viewport Fit button)", "keywords": ["face", "pick face"]},
        {"combo": "Shift+E", "action": "Pick edge", "keywords": ["edge", "pick edge"]},
        {"combo": "L", "action": "Lasso region", "keywords": ["lasso", "region"]},
        {"combo": "N", "action": "Line / path pick", "keywords": ["line", "path", "route"]},
        {"combo": "W", "action": "Toggle wireframe", "keywords": ["wireframe"]},
        {"combo": "I", "action": "Measure (same as M)", "keywords": ["measure", "dimension", "distance"]},
        {"combo": "Shift+X", "action": "Section view", "keywords": ["section", "cutaway"]},
        {"combo": "Shift+G", "action": "Toggle grid", "keywords": ["grid"]},
        {"combo": "Tab", "action": "Toggle Orbit (left-drag camera) vs Select/edit", "keywords": ["orbit", "select mode", "tab"]},
        {"combo": "Esc", "action": "Exit pick/gizmo, clear selection, restore orbit; also clears transparent picks", "keywords": ["escape", "cancel", "orbit"]},
        {"combo": "Delete", "action": "Delete selected object", "keywords": ["delete", "remove", "backspace"]},
        {"combo": "Backspace", "action": "Delete selected object", "keywords": ["delete", "remove"]},
        {"combo": "X", "action": "Delete selected object (not Shift+X)", "keywords": ["delete", "cut"]},
        {"combo": "Cmd+Z", "action": "Undo last viewport / object move", "keywords": ["undo"]},
        {"combo": "Cmd+Shift+Z", "action": "Redo", "keywords": ["redo"]},
        {"combo": "Cmd+Y", "action": "Redo", "keywords": ["redo"]},
        {"combo": "Cmd+C", "action": "Copy selection as a prompt @ link", "keywords": ["copy", "clipboard", "prompt link"]},
        {"combo": "Cmd+V", "action": "Paste / duplicate the copied object in this project", "keywords": ["paste", "duplicate"]},
        {"combo": "Cmd+F", "action": "Viewport Spotlight search (projects, prompts, history)", "keywords": ["find", "search", "spotlight"]},
        {"combo": "E", "action": "Extrude / pad", "keywords": ["extrude", "pad", "press-pull"]},
        {"combo": "P", "action": "Pad", "keywords": ["pad", "extrude"]},
        {"combo": "Shift+P", "action": "Pocket", "keywords": ["pocket", "cut"]},
        {"combo": "O", "action": "Hole", "keywords": ["hole"]},
        {"combo": "B", "action": "Boolean", "keywords": ["boolean", "cut", "union"]},
        {"combo": "Shift+F", "action": "Fillet", "keywords": ["fillet", "round"]},
        {"combo": "Shift+C", "action": "Chamfer", "keywords": ["chamfer", "bevel"]},
        {"combo": "Shift+T", "action": "Thickness / shell", "keywords": ["thickness", "shell", "hollow"]},
        {"combo": "Shift+D", "action": "Draft", "keywords": ["draft", "taper"]},
        {"combo": "Shift+R", "action": "Groove", "keywords": ["groove"]},
        {"combo": "Shift+M", "action": "Mirror", "keywords": ["mirror"]},
        {"combo": "H", "action": "Open History tab", "keywords": ["history", "features"]},
        {"combo": "U", "action": "Cycle display units", "keywords": ["units", "mm", "inch"]},
        {"combo": "Enter", "action": "Finish line path or commit a measurement", "keywords": ["enter", "finish", "commit"]},
        {"combo": "LMB", "action": "Orbit camera, or select when in Select/edit mode", "keywords": ["orbit", "mouse", "left click"]},
        {"combo": "RMB", "action": "Pan camera", "keywords": ["pan", "mouse"]},
        {"combo": "Scroll", "action": "Zoom", "keywords": ["zoom", "scroll"]},
        {"combo": "Space", "action": "Play/pause rigging Motion (RIGGING tab only)", "keywords": ["space", "playback", "rigging", "motion"]}
      ]
    },
    {
      "id": "canvas",
      "title": "Canvas tab",
      "when": "CANVAS design tab is active. Letter keys do not reach the 3D viewport.",
      "keys": [
        {"combo": "V", "action": "Select", "keywords": ["select"]},
        {"combo": "P", "action": "Pen", "keywords": ["pen", "draw"]},
        {"combo": "E", "action": "Eraser", "keywords": ["eraser"]},
        {"combo": "R", "action": "Rectangle", "keywords": ["rect", "rectangle"]},
        {"combo": "C", "action": "Circle", "keywords": ["circle"]},
        {"combo": "L", "action": "Line", "keywords": ["line"]},
        {"combo": "A", "action": "Arrow", "keywords": ["arrow"]},
        {"combo": "T", "action": "Text (not transparent — Canvas owns T)", "keywords": ["text", "type"]},
        {"combo": "D", "action": "Diamond", "keywords": ["diamond"]},
        {"combo": "N", "action": "Note", "keywords": ["note"]},
        {"combo": "Cmd+Z", "action": "Undo canvas stroke / object", "keywords": ["undo"]},
        {"combo": "Cmd+Shift+Z", "action": "Redo canvas", "keywords": ["redo"]},
        {"combo": "Delete", "action": "Delete selected canvas object", "keywords": ["delete"]}
      ]
    },
    {
      "id": "sketch",
      "title": "Constrained Sketch",
      "when": "SKETCH is active. Letter keys stay in the sketch editor.",
      "keys": [
        {"combo": "V", "action": "Select", "keywords": ["select"]},
        {"combo": "L", "action": "Line", "keywords": ["line"]},
        {"combo": "R", "action": "Rectangle", "keywords": ["rectangle"]},
        {"combo": "C", "action": "Circle", "keywords": ["circle"]},
        {"combo": "A", "action": "Arc", "keywords": ["arc"]},
        {"combo": "S", "action": "Spline", "keywords": ["spline"]},
        {"combo": "P", "action": "Point", "keywords": ["point"]},
        {"combo": "D", "action": "Dimension", "keywords": ["dimension"]},
        {"combo": "O", "action": "Offset", "keywords": ["offset"]},
        {"combo": "T", "action": "Trim", "keywords": ["trim"]},
        {"combo": "E", "action": "Equal constraint", "keywords": ["equal"]},
        {"combo": "H", "action": "Horizontal constraint", "keywords": ["horizontal"]},
        {"combo": "Shift+C", "action": "Coincident", "keywords": ["coincident"]},
        {"combo": "Shift+E", "action": "Equal", "keywords": ["equal"]},
        {"combo": "Shift+F", "action": "Fix", "keywords": ["fix", "lock"]},
        {"combo": "Shift+H", "action": "Horizontal", "keywords": ["horizontal"]},
        {"combo": "Shift+P", "action": "Parallel", "keywords": ["parallel"]},
        {"combo": "Shift+V", "action": "Vertical", "keywords": ["vertical"]},
        {"combo": "Shift+X", "action": "Perpendicular", "keywords": ["perpendicular"]},
        {"combo": "Enter", "action": "Finish sketch", "keywords": ["finish", "exit sketch"]},
        {"combo": "Esc", "action": "Cancel current sketch action", "keywords": ["cancel", "escape"]},
        {"combo": "Cmd+Z", "action": "Sketch undo", "keywords": ["undo"]},
        {"combo": "Cmd+Shift+Z", "action": "Sketch redo", "keywords": ["redo"]}
      ]
    },
    {
      "id": "clip-editor",
      "title": "Clip / video editor",
      "when": "Clip editor tab is open; not typing in an editor field.",
      "keys": [
        {"combo": "Space", "action": "Play / pause the timeline; restart from the beginning if the playhead is at the end", "keywords": ["space", "play", "pause", "restart", "clip", "video", "timeline"]},
        {"combo": "S", "action": "Split selected clip at the playhead", "keywords": ["split", "cut", "playhead"]},
        {"combo": "T", "action": "Trim the selected clip at the playhead", "keywords": ["trim", "clip", "in", "out"]},
        {"combo": "M", "action": "Mute or unmute the selected video or audio clip", "keywords": ["mute", "audio", "sound"]},
        {"combo": "Backspace", "action": "Delete the selected clip or audio", "keywords": ["delete", "remove", "backspace"]},
        {"combo": "Delete", "action": "Delete the selected clip or audio", "keywords": ["delete", "remove"]},
        {"combo": "C", "action": "Copy selected clip, sound, or image", "keywords": ["copy", "clipboard"]},
        {"combo": "V", "action": "Paste at the playhead", "keywords": ["paste", "clipboard"]},
        {"combo": "Cmd+Enter", "action": "Run the clip-editor AI edit prompt", "keywords": ["generate", "edit", "prompt"]}
      ]
    }
  ]
}
