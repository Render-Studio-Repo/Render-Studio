#!/bin/sh
# Fail the push if repository invariants or locked feature checks fail.
# Install: ln -sf ../../scripts/git-hooks/pre-push .git/hooks/pre-push
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
if [ ! -d "$root/ai-context/ops/debugger" ]; then
  echo "ops: ai-context/ops/debugger/ is required on every push. Read ai-context/ops/README.md" >&2
  exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  node "$root/scripts/feature-map.mjs" verify-git --base "$remote_sha" --head "$local_sha" || exit $?
done
exit 0
