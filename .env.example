OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_MODEL_QUALITY=gpt-6-astra
OPENAI_REASONING_EFFORT=low

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_MODEL_QUALITY=kimi-k3

JWT_SECRET=
# If JWT_SECRET is unset, the server persists a signing key in $DATA_DIR/jwt_secret
# so KeepAlive restarts do not invalidate existing logins.
JWT_EXPIRE_HOURS=168

HOST=127.0.0.1
PORT=8001
PROJECTS_DIR=projects
DATA_DIR=data

ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
# Onshape rejects 127.0.0.1. Use https in production, or http://localhost:<port>/oauth/callback locally.
ONSHAPE_REDIRECT_URI=https://render3d.app/oauth/callback

AUTODESK_CLIENT_ID=
AUTODESK_CLIENT_SECRET=
AUTODESK_REDIRECT_URI=http://127.0.0.1:8001/oauth/autodesk/callback
AUTODESK_SCOPES=data:read data:write data:create viewables:read

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://render3d.app/oauth/google/callback

# Calendar connect reuses GOOGLE_* / MICROSOFT_* clients (extra scopes on consent).
# Allowlist https://render3d.app/oauth/calendar/callback on both consoles.
# Enable Google Calendar API on the Google Cloud project (Meet + free/busy).
# MICROSOFT app needs Calendars.ReadWrite.
# Meeting reminder loop (30 min before). Set 0 to disable while uvicorn is running.
# RENDER3D_MEETING_REMINDERS=1

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://render3d.app/oauth/microsoft/callback

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=https://render3d.app/oauth/apple/callback
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Capacity collapse alerts (Gmail → sam@render3d.app)
# Create a Google App Password for info@render3d.app (2FA required).
CAPACITY_ALERT_SMTP_HOST=smtp.gmail.com
CAPACITY_ALERT_SMTP_PORT=587
CAPACITY_ALERT_SMTP_USER=info@render3d.app
CAPACITY_ALERT_SMTP_PASSWORD=
CAPACITY_ALERT_FROM=info@render3d.app
CAPACITY_ALERT_TO=sam@render3d.app

RENDER3D_FUSION_BRIDGE_TOKEN=

# Discord product updates + video-editor clip share (bot OR webhook)
DISCORD_BOT_TOKEN=
# Default Share to Discord destination (channel picker prefers this id)
DISCORD_UPDATES_CHANNEL_ID=1512906649822560508
DISCORD_PUBLIC_MODELS_CHANNEL_ID=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://render3d.app/oauth/discord/callback
DISCORD_UPDATES_WEBHOOK_URL=

# X (Twitter) — Connect X / Share to X for viewport videos
# Create an app at https://developer.x.com with OAuth 2.0 + PKCE.
# X / Twitter — OAuth 2.0 app for Connect X + Share to X (viewport video).
# Use Client ID / Client Secret from the X developer portal (User authentication /
# OAuth 2.0). Callback URL must match TWITTER_REDIRECT_URI exactly.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=https://render3d.app/oauth/twitter/callback

# GitHub link (Foundry + Authorized apps) — not a second login identity.
# OAuth App client ID + secret live in the Supabase Auth GitHub provider
# (Management API). Local .env is a runtime copy for /oauth/github/callback
# code exchange — never put these in frontend JS. User PATs go on
# public."Users".github_pat (Fernet ciphertext, service_role only).
# One host OAuth App; each Studio user links their own GitHub (multi-user).
# Register callbacks: GITHUB_REDIRECT_URI (default /oauth/github/callback) and /oauth/github.
# Super admin can paste client ID + secret on Foundry → Pull requests.
# Empty CLIENT_ID/SECRET disables one-click Link GitHub (PAT fallback remains).
# Helper (does not print the secret): python3 scripts/set-github-oauth-env.py
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://render3d.app/oauth/github/callback
# Optional PAT + repo for pushing miniaturized bugs to a bugs branch
GITHUB_TOKEN=
GITHUB_BUGS_REPO=
GITHUB_BUGS_BRANCH=bugs
# PAT needs issues:write. Feature requests use GITHUB_BUGS_REPO (fallback wprojects/Render-Studio) + label feature-request.
# Optional app-only bearer (not required for user Connect / Share to X).
TWITTER_BEARER_TOKEN=

# X Account Activity webhook for the Grok bot (inbound mentions / DMs).
# Public URL: https://render3d.app/api/webhooks/x  (alias /api/x/webhook)
# CRC + POST HMAC use X_CONSUMER_SECRET, else TWITTER_CLIENT_SECRET (API Key Secret).
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_WEBHOOK_PATH=/api/webhooks/x
# Premium AAAPI environment label from developer.x.com → your app → Dev environments.
X_WEBHOOK_ENV=
# If true, Grok bot may post a reply tweet. Leave false unless you intend live replies.
X_WEBHOOK_AUTO_REPLY=false
# Owner user-context tokens for scripts/register-x-webhook.py --register (OAuth 1.0a).
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# LinkedIn product updates
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_ENABLED=true
LINKEDIN_SCHEDULE_NAME=Sam's posts
LINKEDIN_SCHEDULE_TIMEZONE=America/New_York
LINKEDIN_SCHEDULE_WEEKDAY_HOURS=10
LINKEDIN_SCHEDULE_SUNDAY_HOURS=10,16
LINKEDIN_SCHEDULE_RECENT_WINDOW=10

# Supabase — server-side only (secret key never in frontend)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
# After setting URL: apply integrations/supabase/install_users.sql (or 001+002+003) in SQL Editor
# USERS_BACKEND=local keeps sqlite users/passwords/AI keys (old method)
USERS_BACKEND=
# Optional DSN for your own Postgres tooling. This app does not auto-map Users onto it.
DATABASE_URL=
# The installer generates this once. Manual alternative:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_FERNET_KEY=

# WebRTC ICE for Quest / headset voice (GET /api/rtc/ice). Empty = Google STUN only.
# Do not invent Twilio/Metered accounts. Set these only if you already run TURN.
# XR_ICE_SERVERS_JSON=[{"urls":"turn:your-host:3478","username":"","credential":""}]
XR_ICE_SERVERS_JSON=
XR_TURN_URLS=
XR_TURN_USERNAME=
XR_TURN_CREDENTIAL=

# Marketplace payments (Stripe Checkout + Connect). Never commit live keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Public marketplace hub (optional). Leave URL as render3d.app to use the official hub
# that already lives on this instance at /api/marketplace/hub/v1.
# Separate host/repo: services/marketplace-hub/  (suggested GitHub: render-marketplace-hub)
MARKETPLACE_HUB_URL=https://render3d.app
MARKETPLACE_HUB_TOKEN=
# Set this only when this installation has its own public HTTPS origin.
# Leaving it blank prevents a clone from identifying itself as the official hub.
PUBLIC_BASE_URL=

# Optional, explicit opt-in instance health network. The setup page stores the
# choice; this URL is only needed for a self-hosted or test hub.
RENDER3D_INSTANCE_HUB_URL=https://render3d.app

# Private LAN base for the Pi camera wall. Browser clients use authenticated
# same-origin endpoints and never receive this address.
RENDER3D_ROBOT_CAMERA_BASE=http://192.168.1.77:8001

# PayPal Login with PayPal (receive-money + Authorized apps). Leave blank until you have a PayPal app.
# Register redirect: https://render3d.app/oauth/paypal/callback
# Local Bambu LAN (this Mac). Put secrets in gitignored .env only — never commit the access code.
BAMBU_PRINTER_HOST=
BAMBU_PRINTER_ACCESS_CODE=
BAMBU_PRINTER_SERIAL=
BAMBU_PRINTER_NAME=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_REDIRECT_URI=https://render3d.app/oauth/paypal/callback

# Grok music / social API. Never commit the live key. Live value lives in gitignored Marketing/GROK.md
GROK_MUSIC_API_KEY=

# Cursor prompt-trace API (live chats POST outcomes here). Never commit the live key.
PROMPT_TRACE_API_KEY=

# Jev AI (jevai.org MCP + agent tools). Personal key from https://www.jevai.org/agent/keys
JEV_API_KEY=

# Optional: scp incident PDFs into a MacBook Downloads folder (user@host, BatchMode).
INCIDENT_EXPORT_SSH=
INCIDENT_EXPORT_SSH_DIR=Downloads
