APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Capacity collapse alerts (Gmail → sam@render3d.app)
# Create a Google App Password for info@render3d.app (2FA required).
CAPACITY_ALERT_SMTP_HOST=smtp.gmail.com
CAPACITY_ALERT_SMTP_PORT=587
CAPACITY_ALERT_SMTP_USER=info@render3d.app
CAPACITY_ALERT_SMTP_PASSWORD=
CAPACITY_ALERT_FROM=info@render3d.app
CAPACITY_ALERT_TO=sam@render3d.app

RENDER3D_FUSION_BRIDGE_TOKEN=

# Discord product updates (bot OR webhook)
DISCORD_BOT_TOKEN=
DISCORD_UPDATES_CHANNEL_ID=
DISCORD_PUBLIC_MODELS_CHANNEL_ID=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://render3d.app/oauth/discord/callback
DISCORD_UPDATES_WEBHOOK_URL=

# X (Twitter) — Connect X / Share to X for viewport videos
# Create an app at https://developer.x.com with OAuth 2.0 + PKCE.
# X / Twitter — OAuth 2.0 app for Connect X + Share to X (viewport video).
# Use Client ID / Client Secret from the X developer portal (User authentication /
# OAuth 2.0). Callback URL must match TWITTER_REDIRECT_URI exactly.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=https://render3d.app/oauth/twitter/callback
# Optional app-only bearer (not required for user Connect / Share to X).
TWITTER_BEARER_TOKEN=
# Winstead Works -> A1 Projects auto-repost bot path.
# Leave these as placeholders only; never commit real secrets.
X_WW_TO_A1_REPOST_ENABLED=false
# Optional dedicated X app credentials for the repost worker.
X_A1_PROJECTS_APP_KEY=
X_A1_PROJECTS_APP_SECRET=
# Optional bearer token for polling public @Winstead_Works posts without a connected source account.
X_A1_PROJECTS_BEARER_TOKEN=
# Optional dedicated OAuth1 user tokens for @A1_Projects repost/write actions.
# If omitted, the repost worker falls back to the connected A1 primary vault account.
A1_PROJECTS_X_ACCESS_TOKEN=
A1_PROJECTS_X_ACCESS_TOKEN_SECRET=

# LinkedIn product updates
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_ENABLED=true
LINKEDIN_SCHEDULE_NAME=Sam's posts
LINKEDIN_SCHEDULE_TIMEZONE=America/New_York
LINKEDIN_SCHEDULE_WEEKDAY_HOURS=10
LINKEDIN_SCHEDULE_SUNDAY_HOURS=10,16
LINKEDIN_SCHEDULE_RECENT_WINDOW=10

# Supabase — server-side only (secret key never in frontend)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# After setting URL: run supabase/migrations/001_*.sql and 002_auth_profiles_and_secrets.sql in SQL Editor
SECRETS_FERNET_KEY=  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
